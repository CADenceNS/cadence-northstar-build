{
  "name": "@cadence/design-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:private-registration": "node --max-old-space-size=4096 --import tsx --test --test-concurrency=1 private-tests/corpus-certification.test.ts",
    "test:private-preparation": "node --max-old-space-size=4096 --import tsx --test --test-concurrency=1 private-tests/preparation-corpus.test.ts",
    "test:private-crown": "node --max-old-space-size=4096 --import tsx --test --test-concurrency=1 private-tests/crown-corpus.test.ts"
  },
  "dependencies": {
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "latest",
    "vite": "latest",
    "tsx": "4.23.1"
  }
}
