# Required preview runtime variables
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
NODE_ENV=production
NORTHSTAR_INTERNAL_CONTEXT_SECRET=REPLACE_WITH_A_GENERATED_SECRET_OF_AT_LEAST_32_CHARACTERS
NORTHSTAR_PUBLIC_ORIGIN=https://preview.cadencenorthstar.com
# Required only while the first existing admin credential has not been initialized.
NORTHSTAR_BOOTSTRAP_PASSWORD=REPLACE_WITH_A_GENERATED_BOOTSTRAP_PASSWORD

# Provider-assigned external listener. Do not set when the host supplies PORT.
# PORT=8080
# Private loopback listener used only by the gateway process.
NORTHSTAR_INTERNAL_UPSTREAM_PORT=4001

# Optional existing runtime variables
# NORTHSTAR_TENANT_ID=
# DB_POOL_MAX=20
# NORTHSTAR_UAT_PASSWORD=
# NORTHSTAR_ENVIRONMENT=production
# NORTHSTAR_BUILD_VERSION=
# GIT_COMMIT_SHA=
# BUILD_TIMESTAMP=
