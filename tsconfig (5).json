    phone: '818-555-0148', email: 'office@northstardental.example', address: '19350 Business Ctr Dr',
    city: 'Northridge', state: 'CA', postalCode: '91324', taxExempt: false, scannerType: 'iTero',
    createdAt: new Date().toISOString()
  }
];

const initialDoctors: Doctor[] = [
  {
    id: 'doctor-1', practiceId: 'practice-1', firstName: 'Beibei', lastName: 'Wu', specialty: 'General Dentistry',
    email: 'doctor@example.com', phone: '818-555-0171', active: true, createdAt: new Date().toISOString()
  }
];

const initialCases: LaboratoryCase[] = [
  {
    id: 'case-1', caseNumber: 'NS-260724-014', practiceId: 'practice-1', doctorId: 'doctor-1',
